# Promo Studio — copia in .env (mai committare .env). Nessun valore reale qui.

# Interruttore generale: senza true, drafts e publish non fanno niente (default off).
# PROMO_ENABLED=false
# PROMO_LANGUAGES=it,en,es
# Lingue che vanno anche sul canale Telegram del gioco (uno solo):
# PROMO_TELEGRAM_LANGUAGES=it

# Checkout locale di michelecoppi/guess_the_player_from_the_path (dataset, sfide, stile, PostHog).
# GAME_REPO_PATH=../guess_the_player_from_the_path
# Credenziali Firestore del gioco (le stesse del bot); in Actions: Workload Identity.
# FIREBASE_CREDENTIALS_PATH=firebase-key.json

# Coda: firestore (default) oppure local (file JSON, per provare senza Firestore).
# PROMO_STORE=firestore
# Demo senza Firestore: solo pool riservato (vedi docs/demo-setup.md). Richiede PROMO_STORE=local.
# PROMO_OFFLINE=false
# PROMO_LOCAL_STORE=promo_posts.json
# PROMO_MEDIA_DIR=promo-media
# Nome registrato nell'audit quando approvi dalla CLI o dall'admin:
# PROMO_ADMIN_NAME=

# Telegram: token del bot (segreto) e canale di proprieta' dove pubblicare.
# BOT_TOKEN=
# PROMO_TELEGRAM_CHANNEL_ID=@nome_canale
# Chat privata dell'admin per ricevere il report (facoltativo):
# PROMO_ADMIN_CHAT_ID=

# TikTok Content Posting API (segreti). Il refresh token ruota: meglio in Secret Manager.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REFRESH_TOKEN=
# TIKTOK_REFRESH_TOKEN_SECRET=projects/<progetto>/secrets/tiktok-refresh-token
# PROMO_TIKTOK_TOKEN_FILE=~/.config/promo_studio/tiktok.json

# X / Threads: fase successiva (non ancora implementato).
# PROMO_X_ENABLED=false

# Report settimanale (gia' usate dal gioco per la dashboard).
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# PROMO_COSTS_FILE=costs.json
